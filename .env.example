# ============================================================
# POLYMARKET CONFIGURATION
# ============================================================
# Your Polygon wallet private key (the one funded with USDC)
POLYMARKET_PRIVATE_KEY=0x...

# Your wallet address (public)
POLYMARKET_FUNDER_ADDRESS=0x...

# Signature type: 0 = EOA wallet, 1 = Magic/Email wallet
POLYMARKET_SIGNATURE_TYPE=0

# CLOB API host
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# Gamma API host
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# ============================================================
# CLAUDE AI CONFIGURATION
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for probability estimation
ANTHROPIC_MODEL=claude-opus-4-6

# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ============================================================
# TRADING PARAMETERS
# ============================================================
# Total capital in USDC
TOTAL_CAPITAL=200

# Max % of capital per trade (safety cap)
MAX_POSITION_PCT=0.10

# Kelly fraction (0.25 = quarter kelly, conservative)
KELLY_FRACTION=0.25

# Minimum edge required to trade (e.g. 0.08 = 8% edge)
MIN_EDGE_THRESHOLD=0.08

# Minimum liquidity required in a market (USDC)
MIN_MARKET_LIQUIDITY=5000

# Paper trading mode (true = no real trades, false = live)
PAPER_TRADING=true

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///data/db/trades.db
